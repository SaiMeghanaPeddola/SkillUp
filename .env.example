# SkillUp — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and NEVER bundled into the frontend build.
#
# --------------------------------------------------------------------------
# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
# Used by server.js / api/chat.js ONLY — never read by the React frontend.
# --------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the port the Express API server listens on (default: 3001)
# API_PORT=3001
